# Copiá este archivo como .env y completá tus valores reales.
# El .env NUNCA se sube a git (está en .gitignore).

# Webhook de Discord para ENVIAR los avisos (salida).
# Cómo obtenerlo: en Discord -> tu servidor -> Configuración del canal (⚙)
# -> Integraciones -> Webhooks -> Nuevo webhook -> Copiar URL del webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Token del BOT de Discord para RECIBIR mensajes (configurar aviso conversacional).
# Cómo obtenerlo: discord.com/developers/applications -> tu app -> Bot -> Reset/Copy Token.
# Requiere activar "Message Content Intent" en esa misma pantalla.
DISCORD_BOT_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX.YYYYYY.ZZZZZZZZZZZZZZZZZZZZZZZZZZZ

# Webhook de un canal propio por criterio (el criterio lo referencia con "webhook_env").
DISCORD_WEBHOOK_ALQUILER=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Cada cuántas horas corre la búsqueda automática (default: 1). Acepta decimales
# (ej: 0.5 = cada 30 min). No lo pongas muy bajo para no abusar de Zonaprop.
INTERVALO_BUSQUEDA_HORAS=1
